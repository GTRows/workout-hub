# Claude Code local settings (user-specific, not shared)
.claude/settings.local.json
.claude/.setup-complete
.claude/scheduled_tasks.lock

# Codex local settings and runtime state (user-specific, not shared)
.Codex/settings.local.json
.Codex/.setup-complete
.Codex/setup-followups.md
.Codex/scheduled_tasks.lock

# oh-my-claudecode plugin local state (sessions, memory)
.omc/

# Dependencies
node_modules/
vendor/
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# Build output
dist/
build/
out/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
service-account.json

# Self-hosted bind-mount data root (operator state - never committed)
data/*
!data/.gitkeep
!data/postgres/
data/postgres/*
!data/postgres/.gitkeep
!data/backups/
data/backups/*
!data/backups/.gitkeep

# Compose local override (operator copies .example, gitignored)
docker-compose.override.yml

# Logs
*.log
logs/

# Test coverage
coverage/
.coverage
htmlcov/
.nyc_output/

# Package manager locks (uncomment the one you do NOT use)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Snapshots taken by /gtr:update before applying breaking migrations
.claude/commands.pre-*/
.claude/migration-log.md
.Codex/commands.pre-*/
.Codex/migration-log.md

# Token usage telemetry (per-clone, never shipped)
.claude/usage-log.jsonl
.Codex/usage-log.jsonl

# Hook block audit (per-clone, never shipped)
.claude/hook-audit.log
.Codex/hook-audit.log
