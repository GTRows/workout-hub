# ----- WorkoutHub environment template -----
# Copy to `.env` and fill real values. Never commit `.env`.
# docker-compose reads this file from the repo root.

# ----- PostgreSQL (db service) -----
POSTGRES_DB=workouthub
POSTGRES_USER=workouthub
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_PORT=5432

# ----- Backend (Spring Boot) -----
# Active profile: local | docker | prod
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# JDBC URL points at the db service inside the compose network (host=db).
# For local dev without docker, swap host to localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/workouthub
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# JWT settings. Secret MUST be at least 32 bytes in production. Generate with:
#   openssl rand -base64 48
APP_JWT_SECRET=replace-with-32-byte-minimum-base64-secret
APP_JWT_ACCESS_TTL_SECONDS=3600
APP_JWT_REFRESH_TTL_SECONDS=1209600

# CORS: comma-separated list of allowed origins for the API
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Admin bootstrap -----
# Public registration is disabled. On first start, if both APP_ADMIN_EMAIL
# and APP_ADMIN_PASSWORD_HASH are non-empty AND no user with that email
# exists yet, the application seeds a single ADMIN user with these
# credentials. Subsequent user management happens via /api/admin/users.
#
# Generate the BCrypt hash with:
#   ./scripts/hash-password.sh 'your-strong-password'
# The hash starts with $2a$ / $2b$ / $2y$ -- all accepted by Spring Security.
APP_ADMIN_EMAIL=admin@workouthub.local
APP_ADMIN_PASSWORD_HASH=
APP_ADMIN_DISPLAY_NAME=Admin

# ----- Frontend (Next.js) -----
# Public base URL the browser uses to reach the API.
# In docker compose, the browser still reaches the host port, not the internal service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# ----- Optional: nginx reverse proxy -----
# PUBLIC_HOSTNAME=workouthub.local
