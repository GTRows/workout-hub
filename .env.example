# ----- WorkoutHub environment template -----
# Copy to `.env` and fill real values. Never commit `.env`.
# docker compose reads this file from the repo root.

# ============================================================
# Compose host binding and port mapping
# ============================================================

# Interface to publish all service ports on. 127.0.0.1 = loopback (safe default).
# Operators tunnel via Tailscale / WireGuard set this to the VPN interface IP.
# Never set to 0.0.0.0 in production - it exposes the stack to every host interface.
BIND_ADDR=127.0.0.1

# Host-side port for the backend API. Container always listens on 8080.
BACKEND_PORT=8080

# Host-side port for the frontend (Next.js standalone server).
FRONTEND_PORT=3000

# Host-side port for PostgreSQL. Only useful if the operator runs psql against the host port.
POSTGRES_PORT=5432

# ============================================================
# PostgreSQL service
# ============================================================

# Database name. Used by both Postgres init and Spring datasource URL.
POSTGRES_DB=workouthub

# DB superuser. Spring connects with this user.
POSTGRES_USER=workouthub

# DB password. SECRET. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_BASE64_32

# ============================================================
# Backend (Spring Boot)
# ============================================================

# Active profile selector. Recognized values: local | docker | prod.
# `prod` activates structured JSON logs and the secret masking customizer.
SPRING_PROFILES_ACTIVE=docker

# In-container backend listener port. Keep aligned with the BACKEND_PORT mapping above.
SERVER_PORT=8080

# JDBC URL points at the db service inside the compose network (host=db).
# For local dev outside compose, swap host to localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/workouthub

# Datasource credentials (typically interpolated from POSTGRES_USER / POSTGRES_PASSWORD).
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# JWT signing key for built-in auth. SECRET. Must be at least 32 bytes (HS256).
# Generate with: openssl rand -base64 48
APP_JWT_SECRET=CHANGE_ME_BASE64_48

# JWT lifetimes in seconds.
APP_JWT_ACCESS_TTL_SECONDS=3600
APP_JWT_REFRESH_TTL_SECONDS=1209600

# CORS: comma-separated list of allowed origins for the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# Admin bootstrap
# ============================================================

# Public registration is disabled. On first start, if both APP_ADMIN_EMAIL and
# APP_ADMIN_PASSWORD_HASH are non-empty AND no user with that email exists,
# the application seeds a single ADMIN user with these credentials.
# Subsequent user management happens via /api/admin/users.
APP_ADMIN_EMAIL=admin@workouthub.local

# BCrypt hash of the admin password. SECRET.
# Generate with: ./scripts/hash-password.sh 'your-strong-password'
# Hash starts with $2a$ / $2b$ / $2y$.
APP_ADMIN_PASSWORD_HASH=

APP_ADMIN_DISPLAY_NAME=Admin

# ============================================================
# Authentication mode (built-in JWT default; forward-auth opt-in)
# ============================================================

# AUTH_MODE: builtin | forward-auth.
# `builtin` uses local JWT (the default).
# `forward-auth` trusts identity headers from a reverse-proxy SSO gateway
# (Authentik / Authelia / oauth2-proxy). Headers ONLY honoured when the
# request source IP is in APP_AUTH_TRUSTED_PROXIES (non-optional gate).
APP_AUTH_MODE=builtin

# Comma-separated CIDR list of reverse-proxy IPs that may inject identity headers.
# Empty = trust nothing (the safe default; required when APP_AUTH_MODE=builtin).
# Example for a homelab tailnet + LAN proxy: 100.64.0.0/10,10.0.0.0/8
APP_AUTH_TRUSTED_PROXIES=

# Identity header names. Override only if the proxy uses non-default names.
APP_AUTH_HEADER_USER=X-Forwarded-User
APP_AUTH_HEADER_EMAIL=X-Forwarded-Email
APP_AUTH_HEADER_GROUPS=X-Forwarded-Groups

# ============================================================
# Web Push (VAPID)
# ============================================================

# VAPID keypair for Web Push notifications. SECRETS.
# Generate with the project script (or `npx web-push generate-vapid-keys`):
#   ./scripts/vapid-keygen.sh
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=

# Subject (mailto: URL) used in VAPID JWT 'sub' claim. Required by push services.
APP_PUSH_VAPID_SUBJECT=mailto:admin@localhost

# ============================================================
# Reminder cron schedules (empty = disabled)
# ============================================================

# Cron expressions for periodic reminder push notifications.
# Empty string disables that reminder. Spring CronExpression syntax (6 fields).
# Example: 0 0 18 * * * runs every day at 18:00 local time.
APP_REMINDERS_WORKOUT_CRON=
APP_REMINDERS_WEIGHT_CRON=
APP_REMINDERS_SUPPLEMENT_CRON=

# ============================================================
# Optional pg_dump backup sidecar (Phase 7 ships the actual sidecar)
# ============================================================

# Set to true to enable the opt-in postgres backup sidecar that writes
# pg_dump --format=custom snapshots into ./data/backups/.
ENABLE_PG_DUMP=false

# Cron expression for the backup. Default 03:00 daily.
PG_DUMP_SCHEDULE=0 3 * * *

# Keep snapshots for this many days; older are pruned.
PG_DUMP_RETENTION_DAYS=7

# ============================================================
# Frontend (Next.js)
# ============================================================

# Public base URL the browser uses to reach the API.
# In docker compose, the browser still reaches the host port, not the internal service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Default UI locale (currently `tr` or `en`).
NEXT_PUBLIC_DEFAULT_LOCALE=tr
